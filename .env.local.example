NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح service_role — بيستخدمه سيرفر الـ webhook بس لكتابة الكوميتات (بيخطي RLS). مخفي، ما يوصلش للمتصفح.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# سر الـ Webhook: نفس القيمة اللي بتحطها في secret جوه الـ hook في جيت هب، ومسؤول عن توقيع HMAC.
# هات قيمة عشوائية طويلة: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me-long-random-string
